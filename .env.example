# Variables públicas: se fijan al compilar (pnpm build / pnpm run deploy) y src/env.ts las valida.
# Producción: en Cloudflare Workers Builds van en "Variables de compilación"; para desplegar desde
# tu máquina, ponlas en .env.production (Vite la usa en `vite build` por encima de .env).

# API de ME, con el prefijo de la versión
VITE_API_ENDPOINT=https://api.example.com/api/v1

# Origen del sitio: canonical, Open Graph, QR (/t/{id}) y enlaces de las tarjetas
PUBLIC_SITE_URL=https://me.svelpy.com

# Google Analytics (opcional): descomentar con el ID real
# PUBLIC_GA_ID=G-XXXXXXXXXX
